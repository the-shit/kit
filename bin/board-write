#!/usr/bin/env bash
# Grok / factory sessions: flock-write the canonical board. Not a Mattermost mouth.
# Usage: bin/board-write <id> <state> [--lifecycle=cut] [--owner=kit] [--issue=4] [--pr=URL] [--note=...]
